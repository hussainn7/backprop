# Tuned settings from the MacBook deployment (2026-10-31). Copy to agent-swarm/.env.
# Contains no secrets: the API key goes in config/secrets.env (ANTHROPIC_API_KEY=...).
# Non-secret agent settings. The API key lives in ../config/secrets.env (chmod 600),
# loaded by the mc-agents systemd unit — never put it in this file.

# Bots join through the local-only offline Velocity proxy
MC_HOST=127.0.0.1
MC_PORT=25567
MC_VERSION=1.21.4
MC_AUTH=offline
MC_USERNAME=Atlas
MC_USERNAME_2=Flora
MC_USERNAME_3=Forge
MC_USERNAME_4=Mason
MC_USERNAME_5=Blade

# ── Anthropic ────────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_FAST_MODEL=claude-haiku-5-5        # routine decisions
ANTHROPIC_PLANNER_MODEL=claude-sonnet-5-5    # periodic strategic replans
ANTHROPIC_PLANNER_INTERVAL_MIN=60            # per bot; 0 disables Sonnet
ANTHROPIC_PLANNER_MAX_SHARE=0.35             # no Sonnet once 35% of the daily cap is spent
ANTHROPIC_DAILY_CAP_USD=2                    # hard daily cap (local midnight reset)
ANTHROPIC_TOTAL_CAP_USD=5                    # lifetime testing budget — raise deliberately
ANTHROPIC_PACING_BURST=0.15                  # how far ahead of an even daily pace spending may run
ANTHROPIC_MAX_RPM=20                         # requests/minute across all bots

# ── Bots ─────────────────────────────────────────────────────────────────────
ENABLE_MULTI_BOT=true
BOT_COUNT=5                    # scale up gradually: 1 → 2 → 3 → 5
BOT_IDLE_INTERVAL_MS=45000     # strategic re-plan interval (cost lever)
BOT_CRITIC_ENABLED=true        # Haiku critic chains the next action after each one (~$0.0001/call)
ALLOW_INTERVENTIONS=false      # no teleports / item handouts — legit survival only
ALLOW_STRATEGY_OVERRIDES=true  # deterministic skill scheduling (not cheats)
BOT_COMMAND_WHITELIST=SirFinnn      # may use !status, !come, !stay, !resume, !goal, !inventory
BOTS_MAY_ATTACK_PLAYERS=false
TTS_ENABLED=false
BIND_HOST=127.0.0.1
LOG_LEVEL=info
GENERATED_SKILLS_ENABLED=false

# Pathfinding CPU budget (old CPU, all bots share one Node thread)
PATHFINDER_TICK_MS=4           # ms of A* per bot per 50 ms tick (library default 40)
PATHFINDER_THINK_MS=8000       # wall-clock search limit; 30000 let failed searches fill memory with millions of nodes
VIEWER_ENABLED=false          # 3D bot viewers off to save RAM/CPU (dashboard cards still work)

# Base location in THIS world (upstream hard-coded its own world coords)
BASE_POS=342,64,-337           # world spawn set by SirFinnn
FARM_POS=342,64,-337           # build_farm searches for water within 96 blocks
TREE_FARM_POS=342,64,-337

# Team mission injected into every planning prompt (overrides per-bot season goals)
TEAM_GOAL=Beat Minecraft as a team. You carry max netherite gear, golden apples, 16 ender pearls and 16 eyes of ender. Stick together near Atlas, explore far to find the stronghold (strongholds sit 1300-2800 blocks from 0,0 in rings), then reach the End and kill the Ender Dragon: shoot the end crystals on the pillars with your bow, then melee the dragon when it perches. Eat golden carrots to stay full and golden apples when hurt.
